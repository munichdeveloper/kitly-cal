# Rename to .env and fill in the values. Never commit .env.

# =================
# API keys
# =================
# Comma-separated, at least 24 characters each. Generate with: openssl rand -hex 24
# The app uses one of them as CALCOM_API_KEY.
KITLY_CAL_API_KEYS=
# Keys for testing against the running service: no real slots, no mail, no calendar entry, no live webhook.
KITLY_CAL_SANDBOX_API_KEYS=

# =================
# Webhook to the app (BOOKING_CREATED)
# =================
# Use the www host: a redirect counts as a failure.
KITLY_CAL_WEBHOOK_URL=https://www.digitalsmallbusiness.de/api/cal/webhook
# Same value as CALCOM_WEBHOOK_SECRET in the app.
KITLY_CAL_WEBHOOK_SECRET=
# Optional receiver for sandbox bookings. Must differ from KITLY_CAL_WEBHOOK_URL.
KITLY_CAL_SANDBOX_WEBHOOK_URL=

# =================
# Local docker-compose.yml
# =================
POSTGRES_PASSWORD=postgres
KITLY_CAL_PORT=8081
KITLY_CAL_DB_PORT=5433
# Mock profile: set a URL and FORWARD=true to really send webhooks to a locally running app.
KITLY_CAL_MOCK_PORT=4010
KITLY_CAL_MOCK_WEBHOOK_URL=
KITLY_CAL_MOCK_FORWARD_WEBHOOKS=false

# =================
# docker-compose-production.yml
# =================
KITLY_CAL_HOST=termine.example.com
LETSENCRYPT_EMAIL=
KITLY_CAL_DATASOURCE_URL=
KITLY_CAL_DATASOURCE_USERNAME=
KITLY_CAL_DATASOURCE_PASSWORD=
KITLY_CAL_DB_SCHEMA=public
